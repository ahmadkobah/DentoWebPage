---
import SiteLayout from '../layouts/SiteLayout.astro';
import LegalArticle from '../components/LegalArticle.astro';
import { getUi } from '../i18n/utils';

const lang = 'en' as const;
const t = getUi(lang);
---

<SiteLayout
  lang={lang}
  path="/privacy"
  title={`${t.legal.privacy.title} — ${t.meta.brand}`}
  description={t.legal.privacy.lead}
>
  <LegalArticle lang={lang} doc={t.legal.privacy} />
</SiteLayout>
