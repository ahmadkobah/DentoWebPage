---
/**
 * Logo — tooth mark + "Dento" wordmark, linking to the locale home.
 * Brand text comes from the copy deck so it localizes (Dento / دينتو).
 */
import { getUi, localePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
  class?: string;
  /** Set a CSS view-transition-name so the logo morphs across page navigations.
   *  Pass ONLY on the header logo (a name must be unique per page). */
  transitionName?: string;
}
const { lang, class: className = '', transitionName } = Astro.props;
const t = getUi(lang);
---

<a
  href={localePath(lang, '/')}
  class:list={['inline-flex items-center gap-2.5 font-extrabold text-brand-700 dark:text-brand-200', className]}
  style={transitionName ? `view-transition-name:${transitionName}` : undefined}
  aria-label={t.meta.brand}
>
  <span class="grid size-9 place-items-center rounded-xl bg-brand-600 text-white shadow-soft">
    <svg viewBox="0 0 32 32" class="size-5" aria-hidden="true" fill="currentColor">
      <path
        d="M16 7.2c-1.9 0-2.9-1-4.9-1-2.3 0-3.9 1.5-3.9 4 0 2.1.7 3.7 1.4 6 .8 2.6 1 6 2.6 6 1.4 0 1.3-3.4 2.4-3.4 .6 0 .8 1.1 1.4 1.1h1.2c.6 0 .8-1.1 1.4-1.1 1.1 0 1 3.4 2.4 3.4 1.6 0 1.8-3.4 2.6-6 .7-2.3 1.4-3.9 1.4-6 0-2.5-1.6-4-3.9-4-2 0-3 1-4.9 1z"
      ></path>
    </svg>
  </span>
  <span class="text-xl tracking-tight">{t.meta.brand}</span>
</a>
