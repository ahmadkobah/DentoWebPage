---
/** Hero — value proposition, primary CTA, and a product preview. */
import { Icon } from 'astro-icon/components';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import MockApp from '../MockApp.astro';
import ToothWatermark from '../decor/ToothWatermark.astro';
import HeroToolGlyphs from '../decor/HeroToolGlyphs.astro';
import { getUi, localePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);
const home = localePath(lang, '/');
const trust = [t.hero.trust1, t.hero.trust2, t.hero.trust3];
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-50/70 via-white to-white dark:from-brand-900/20 dark:via-[var(--color-bg)] dark:to-[var(--color-bg)]"
  >
  </div>

  <!-- Faint brand tooth watermark, bleeding off the start gutter -->
  <ToothWatermark class="start-[-9rem] top-1/2 w-[30rem] -translate-y-1/2 text-brand-200/60 dark:text-brand-800/50" />

  <div class="container-page grid items-center gap-12 py-12 md:py-18 lg:grid-cols-2 lg:gap-8">
    <div>
      <div data-reveal style="--reveal-delay:0ms">
        <Badge>{t.hero.eyebrow}</Badge>
      </div>

      <h1
        class="mt-5 text-4xl font-extrabold leading-[1.1] tracking-tight text-[var(--color-heading)] sm:text-5xl lg:text-6xl"
        data-reveal
        style="--reveal-delay:80ms"
      >
        {t.hero.title}{' '}
        <span class="text-brand-600">{t.hero.titleHighlight}</span>
      </h1>

      <p
        class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-muted)]"
        data-reveal
        style="--reveal-delay:160ms"
      >
        {t.hero.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay:240ms">
        <Button
          href={`${home}#demo`}
          size="lg"
          icon="lucide:arrow-right"
          iconPosition="end"
          class="rtl-flip"
        >
          {t.hero.primaryCta}
        </Button>
        <Button href={`${home}#features`} size="lg" variant="secondary">
          {t.hero.secondaryCta}
        </Button>
      </div>

      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2" data-reveal style="--reveal-delay:320ms">
        {
          trust.map((item) => (
            <li class="flex items-center gap-2 text-sm text-[var(--color-muted)]">
              <Icon name="lucide:check" class="size-4 shrink-0 text-brand-600" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative" data-reveal style="--reveal-delay:120ms">
      <!-- decorative glow -->
      <div
        class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-brand-200/30 blur-2xl"
      >
      </div>
      <MockApp lang={lang} />
      <!-- after MockApp so the tool glyphs sit in FRONT of the mock -->
      <HeroToolGlyphs class="hidden lg:block" />
    </div>
  </div>
</section>
