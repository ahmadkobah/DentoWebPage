---
/**
 * Why Dento — the four key differentiators.
 * Icons line up with t.why.items BY ORDER.
 */
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';
import DotGrid from '../decor/DotGrid.astro';
import { getUi, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);

const icons = ['lucide:languages', 'lucide:banknote', 'lucide:shield-check', 'lucide:layers'];
const items = t.why.items.map((item, i) => ({ ...item, icon: icons[i] }));
---

<Section id="why" class="relative isolate">
  <DotGrid />
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <Badge vitals>{t.why.eyebrow}</Badge>
    <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-[var(--color-heading)] sm:text-4xl">
      {t.why.title}
    </h2>
    <p class="mt-4 text-lg text-[var(--color-muted)]">{t.why.subtitle}</p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      items.map((item, i) => (
        <div
          class="relative flex gap-5 overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-card)] p-6 shadow-soft md:p-8"
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
        >
          {/* faint tooth-corner brand ghost */}
          <svg
            class="pointer-events-none absolute end-3 top-3 size-9 text-brand-100 dark:text-brand-900"
            viewBox="0 0 32 32"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M16 7.2c-1.9 0-2.9-1-4.9-1-2.3 0-3.9 1.5-3.9 4 0 2.1.7 3.7 1.4 6 .8 2.6 1 6 2.6 6 1.4 0 1.3-3.4 2.4-3.4 .6 0 .8 1.1 1.4 1.1h1.2c.6 0 .8-1.1 1.4-1.1 1.1 0 1 3.4 2.4 3.4 1.6 0 1.8-3.4 2.6-6 .7-2.3 1.4-3.9 1.4-6 0-2.5-1.6-4-3.9-4-2 0-3 1-4.9 1z" />
          </svg>

          <span class="inline-grid size-14 shrink-0 place-items-center rounded-2xl bg-brand-600 text-white shadow-soft">
            <Icon name={item.icon} class="size-7" aria-hidden="true" />
          </span>
          <div>
            <span class="text-xs font-bold tracking-wider text-brand-500 dark:text-brand-400">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-0.5 text-lg font-bold text-ink">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-[var(--color-muted)]">{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>
