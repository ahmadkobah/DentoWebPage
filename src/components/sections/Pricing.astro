---
/** Pricing — three tiers, each funnelling to the demo CTA. */
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { getUi, localePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);
const home = localePath(lang, '/');
---

<Section id="pricing" surface>
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <Badge vitals>{t.pricing.eyebrow}</Badge>
    <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-[var(--color-heading)] sm:text-4xl">
      {t.pricing.title}
    </h2>
    <p class="mt-4 text-lg text-[var(--color-muted)]">{t.pricing.subtitle}</p>
  </div>

  <div class="mx-auto mt-12 grid max-w-5xl items-start gap-6 lg:grid-cols-3">
    {
      t.pricing.tiers.map((tier, i) => (
        <div
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
          class:list={[
            'relative flex h-full flex-col rounded-3xl border bg-[var(--color-card)] p-6 md:p-8',
            tier.highlighted
              ? 'border-brand-300 shadow-lift ring-2 ring-brand-500/60 lg:-mt-3 lg:mb-3'
              : 'border-[var(--color-line)] shadow-soft',
          ]}
        >
          <span
            class="pointer-events-none absolute end-5 top-5 select-none text-6xl font-extrabold leading-none text-brand-100/80 dark:text-brand-900/50"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>

          {tier.highlighted && (
            <span class="absolute -top-3 start-8 inline-flex items-center gap-1.5 rounded-full bg-accent-500 px-3 py-1 text-xs font-semibold text-white shadow-soft">
              <Icon name="lucide:star" class="size-3.5" aria-hidden="true" />
              {t.pricing.popular}
            </span>
          )}

          <h3 class="text-lg font-bold text-ink">{tier.name}</h3>
          <div class="mt-3 flex items-baseline gap-1.5">
            <span class="text-4xl font-extrabold tracking-tight text-[var(--color-heading)]">{tier.price}</span>
            {tier.period && <span class="text-sm text-[var(--color-muted)]">{tier.period}</span>}
          </div>
          <p class="mt-3 text-sm text-[var(--color-muted)]">{tier.description}</p>

          <ul class="mt-6 space-y-3">
            {tier.features.map((feature) => (
              <li class="flex gap-3 text-sm text-ink">
                <Icon
                  name="lucide:check"
                  class="mt-0.5 size-5 shrink-0 text-brand-600"
                  aria-hidden="true"
                />
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 pt-2">
            <Button
              href={`${home}#demo`}
              variant={tier.highlighted ? 'primary' : 'secondary'}
              class="w-full"
            >
              {tier.cta}
            </Button>
          </div>
        </div>
      ))
    }
  </div>

  <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-[var(--color-muted)]">
    {t.pricing.note}
  </p>
</Section>
