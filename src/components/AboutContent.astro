---
/**
 * AboutContent — the body of the /about page (hero, story, values, stats, CTA).
 * Used by both src/pages/about.astro and src/pages/ar/about.astro so the markup
 * lives in one place. Value icons line up with t.about.values BY ORDER.
 */
import { Icon } from 'astro-icon/components';
import Section from './ui/Section.astro';
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import { getUi, localePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);
const a = t.about;
const home = localePath(lang, '/');

const valueIcons = ['lucide:layers', 'lucide:shield-check', 'lucide:heart-pulse', 'lucide:sparkles'];
const values = a.values.map((value, i) => ({ ...value, icon: valueIcons[i] }));
---

<!-- Hero -->
<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-50/70 via-white to-white dark:from-brand-900/20 dark:via-[var(--color-bg)] dark:to-[var(--color-bg)]"
  >
  </div>
  <div class="container-page max-w-3xl py-12 text-center md:py-18" data-reveal>
    <Badge>{a.eyebrow}</Badge>
    <h1
      class="mx-auto mt-5 max-w-2xl text-4xl font-extrabold leading-[1.1] tracking-tight text-[var(--color-heading)] sm:text-5xl"
    >
      {a.title}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg text-[var(--color-muted)]">{a.lead}</p>
  </div>
</section>

<!-- Story -->
<Section>
  <div class="mx-auto max-w-3xl" data-reveal>
    <h2 class="text-2xl font-bold text-[var(--color-heading)] sm:text-3xl">{a.storyTitle}</h2>
    <div class="mt-5 space-y-4 text-lg leading-relaxed text-[var(--color-muted)]">
      {a.story.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</Section>

<!-- Values -->
<Section surface>
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <h2 class="text-3xl font-extrabold tracking-tight text-[var(--color-heading)] sm:text-4xl">
      {a.valuesTitle}
    </h2>
    <p class="mt-4 text-lg text-[var(--color-muted)]">{a.valuesSubtitle}</p>
  </div>
  <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2">
    {
      values.map((value, i) => (
        <div
          class="flex gap-5 rounded-2xl border border-[var(--color-line)] bg-[var(--color-card)] p-6 shadow-soft md:p-8"
          data-reveal
          style={`--reveal-delay:${i * 80}ms`}
        >
          <span class="inline-grid size-14 shrink-0 place-items-center rounded-2xl bg-brand-600 text-white shadow-soft">
            <Icon name={value.icon} class="size-7" aria-hidden="true" />
          </span>
          <div>
            <h3 class="text-lg font-bold text-ink">{value.title}</h3>
            <p class="mt-2 leading-relaxed text-[var(--color-muted)]">{value.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<!-- Stats -->
<Section>
  <h2
    class="text-center text-2xl font-bold text-[var(--color-heading)] sm:text-3xl"
    data-reveal
  >
    {a.statsTitle}
  </h2>
  <dl class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-6 lg:grid-cols-4">
    {
      a.stats.map((stat, i) => (
        <div
          class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-card)] p-6 text-center shadow-soft"
          data-reveal
          style={`--reveal-delay:${i * 70}ms`}
        >
          <dt class="sr-only">{stat.label}</dt>
          <dd>
            <span class="block text-4xl font-extrabold tracking-tight text-brand-600">
              {stat.value}
            </span>
            <span class="mt-2 block text-sm text-[var(--color-muted)]">{stat.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<!-- CTA -->
<Section>
  <div
    class="rounded-3xl bg-brand-600 px-6 py-12 text-center shadow-card md:px-12 md:py-16"
    data-reveal
  >
    <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{a.ctaTitle}</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-brand-50">{a.ctaText}</p>
    <div class="mt-8 flex justify-center">
      <Button href={`${home}#demo`} size="lg">{a.ctaButton}</Button>
    </div>
  </div>
</Section>
