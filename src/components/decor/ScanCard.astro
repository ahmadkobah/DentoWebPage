---
/**
 * ScanCard — a small dental-scan UI mini-card (line-art tooth + scan grid + scan
 * line) bridging dental + tech/imaging. Decorative (aria-hidden). Token-styled
 * so it re-themes in dark; position via `class`.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
  class:list={['rounded-2xl border border-[var(--color-line)] bg-[var(--color-card)] p-3 shadow-card', className]}
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <span class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-muted)]">Scan</span>
    <span class="size-1.5 rounded-full bg-brand-500"></span>
  </div>
  <div class="relative mt-2 grid place-items-center overflow-hidden rounded-lg bg-brand-50/60 py-3 dark:bg-brand-900/30">
    <div class="deco-scangrid pointer-events-none absolute inset-0"></div>
    <svg
      viewBox="0 0 32 32"
      class="relative size-10 text-brand-500 dark:text-brand-300"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      aria-hidden="true"
    >
      <path
        d="M16 7.2c-1.9 0-2.9-1-4.9-1-2.3 0-3.9 1.5-3.9 4 0 2.1.7 3.7 1.4 6 .8 2.6 1 6 2.6 6 1.4 0 1.3-3.4 2.4-3.4 .6 0 .8 1.1 1.4 1.1h1.2c.6 0 .8-1.1 1.4-1.1 1.1 0 1 3.4 2.4 3.4 1.6 0 1.8-3.4 2.6-6 .7-2.3 1.4-3.9 1.4-6 0-2.5-1.6-4-3.9-4-2 0-3 1-4.9 1z"
      />
    </svg>
    <span class="pointer-events-none absolute inset-x-2 top-1/2 h-px bg-brand-500/70"></span>
  </div>
</div>

<style>
  .deco-scangrid {
    background-image:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 8px 8px;
    opacity: 0.5;
  }
</style>
