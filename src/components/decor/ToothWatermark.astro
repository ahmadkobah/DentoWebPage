---
/**
 * ToothWatermark — one oversized, very faint OUTLINE of the brand tooth, used as
 * a barely-there brand watermark in section gutters (never under headings).
 * Reuses the Logo tooth path; edges softened by .deco-soft-mask; flips in RTL.
 * Position, size and colour are passed via `class`.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class:list={['deco-soft-mask pointer-events-none absolute -z-10 rtl:-scale-x-100', className]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M16 7.2c-1.9 0-2.9-1-4.9-1-2.3 0-3.9 1.5-3.9 4 0 2.1.7 3.7 1.4 6 .8 2.6 1 6 2.6 6 1.4 0 1.3-3.4 2.4-3.4 .6 0 .8 1.1 1.4 1.1h1.2c.6 0 .8-1.1 1.4-1.1 1.1 0 1 3.4 2.4 3.4 1.6 0 1.8-3.4 2.6-6 .7-2.3 1.4-3.9 1.4-6 0-2.5-1.6-4-3.9-4-2 0-3 1-4.9 1z"
    stroke="currentColor"
    stroke-width="0.5"
  />
</svg>
