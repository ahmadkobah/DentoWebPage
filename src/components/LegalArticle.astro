---
/**
 * LegalArticle — shared renderer for the privacy / terms / impressum stubs.
 * Pages pass the relevant `doc` from the copy deck (t.legal.privacy, etc.).
 */
import { Icon } from 'astro-icon/components';
import { getUi, localePath, type Lang } from '../i18n/utils';

interface LegalDoc {
  title: string;
  lead: string;
  sections: { h: string; body: string }[];
}
interface Props {
  lang: Lang;
  doc: LegalDoc;
}
const { lang, doc } = Astro.props;
const t = getUi(lang);
---

<article class="container-page max-w-3xl py-12 md:py-18">
  <a
    href={localePath(lang, '/')}
    class="rtl-flip inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 transition hover:text-brand-800"
  >
    <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
    {t.legal.backToHome}
  </a>

  <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-[var(--color-heading)]">{doc.title}</h1>
  <p class="mt-3 text-lg text-[var(--color-muted)]">{doc.lead}</p>
  <p class="mt-4 text-sm text-[var(--color-muted)]">
    {t.legal.updatedLabel} {t.legal.updatedDate}
  </p>

  <div class="mt-6 rounded-xl border border-accent-200 bg-accent-50 px-4 py-3 text-sm text-accent-700">
    {t.legal.placeholderNote}
  </div>

  <div class="mt-10 space-y-8">
    {
      doc.sections.map((section) => (
        <section>
          <h2 class="text-xl font-bold text-ink">{section.h}</h2>
          <p class="mt-2 leading-relaxed text-[var(--color-muted)]">{section.body}</p>
        </section>
      ))
    }
  </div>
</article>
