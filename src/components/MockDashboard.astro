---
/**
 * MockDashboard — a self-contained, CSS/SVG-drawn preview of the Dento app for
 * the hero. Purely decorative (aria-hidden) and intentionally NOT a real image:
 *   - keeps the page light & fast (no external request),
 *   - avoids any third-party asset (GDPR-friendly).
 * TODO: replace with a real, optimized product screenshot (astro:assets) at launch.
 */
import { getUi, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);

// Decorative sample rows — not translated (illustrative only).
const appointments = [
  { time: '09:00', name: 'A. Mahmoud', proc: 'Cleaning', tone: 'brand' },
  { time: '09:45', name: 'L. Haddad', proc: 'Root canal', tone: 'accent' },
  { time: '10:30', name: 'N. Saleh', proc: 'Check-up', tone: 'brand' },
  { time: '11:15', name: 'Y. Karim', proc: 'Whitening', tone: 'muted' },
];
---

<div
  class="overflow-hidden rounded-3xl border border-[var(--color-line)] bg-[var(--color-card)] shadow-card"
  aria-hidden="true"
>
  <!-- Top bar -->
  <div class="flex items-center gap-2 border-b border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-3">
    <span class="size-3 rounded-full bg-accent-300"></span>
    <span class="size-3 rounded-full bg-brand-200"></span>
    <span class="size-3 rounded-full bg-brand-300"></span>
    <div class="mx-auto h-5 w-40 rounded-md bg-[var(--color-card)]"></div>
  </div>

  <div class="grid grid-cols-[3.5rem_1fr] sm:grid-cols-[4.5rem_1fr]">
    <!-- Sidebar -->
    <div class="flex flex-col items-center gap-4 border-e border-[var(--color-line)] bg-[var(--color-card)] py-5">
      <span class="grid size-9 place-items-center rounded-xl bg-brand-600 text-white">
        <svg viewBox="0 0 32 32" class="size-5" fill="currentColor"
          ><path
            d="M16 7.2c-1.9 0-2.9-1-4.9-1-2.3 0-3.9 1.5-3.9 4 0 2.1.7 3.7 1.4 6 .8 2.6 1 6 2.6 6 1.4 0 1.3-3.4 2.4-3.4 .6 0 .8 1.1 1.4 1.1h1.2c.6 0 .8-1.1 1.4-1.1 1.1 0 1 3.4 2.4 3.4 1.6 0 1.8-3.4 2.6-6 .7-2.3 1.4-3.9 1.4-6 0-2.5-1.6-4-3.9-4-2 0-3 1-4.9 1z"
          ></path></svg
        >
      </span>
      <span class="h-7 w-7 rounded-lg bg-brand-100"></span>
      <span class="h-7 w-7 rounded-lg bg-[var(--color-surface)]"></span>
      <span class="h-7 w-7 rounded-lg bg-[var(--color-surface)]"></span>
      <span class="h-7 w-7 rounded-lg bg-[var(--color-surface)]"></span>
    </div>

    <!-- Main panel -->
    <div class="p-4 sm:p-5">
      <div class="flex items-baseline justify-between">
        <div>
          <p class="text-sm font-bold text-ink">{t.hero.mockTitle}</p>
          <p class="text-xs text-[var(--color-muted)]">{t.hero.mockSubtitle}</p>
        </div>
        <span
          class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold tabular-nums text-brand-700 dark:bg-brand-900/40 dark:text-brand-200"
          data-countup="12">12</span>
      </div>

      <!-- Stat chips -->
      <div class="mt-4 grid grid-cols-3 gap-2">
        <div class="rounded-xl bg-[var(--color-surface)] p-2.5">
          <div class="h-2 w-8 rounded bg-brand-200"></div>
          <div class="mock-bar mt-2 h-4 w-10 rounded bg-brand-500/80"></div>
        </div>
        <div class="rounded-xl bg-[var(--color-surface)] p-2.5">
          <div class="h-2 w-8 rounded bg-accent-200"></div>
          <div class="mock-bar mt-2 h-4 w-10 rounded bg-accent-400"></div>
        </div>
        <div class="rounded-xl bg-[var(--color-surface)] p-2.5">
          <div class="h-2 w-8 rounded bg-brand-200"></div>
          <div class="mock-bar mt-2 h-4 w-10 rounded bg-brand-400"></div>
        </div>
      </div>

      <!-- Appointment rows -->
      <div class="mt-4 space-y-2">
        {
          appointments.map((a, i) => (
            <div
              class="mock-row flex items-center gap-3 rounded-xl border border-[var(--color-line)] px-3 py-2"
              style={`--mock-delay:${i * 0.12}s`}
            >
              <span class="text-xs font-semibold tabular-nums text-[var(--color-muted)]">{a.time}</span>
              <span
                class:list={[
                  'size-7 rounded-full',
                  a.tone === 'accent'
                    ? 'bg-accent-100'
                    : a.tone === 'muted'
                      ? 'bg-[var(--color-surface)]'
                      : 'bg-brand-100',
                ]}
              />
              <div class="min-w-0 flex-1">
                <div class="h-2.5 w-24 rounded bg-ink/80"></div>
                <div class="mt-1.5 h-2 w-16 rounded bg-[var(--color-line)]"></div>
              </div>
              <span
                class:list={[
                  'rounded-full px-2 py-0.5 text-[10px] font-semibold',
                  a.tone === 'accent'
                    ? 'bg-accent-50 text-accent-700'
                    : 'bg-brand-50 text-brand-700',
                ]}
              >
                {a.proc}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  // "Dashboard wakes up": count the appointment chip 0 -> target when it scrolls
  // into view. Bars/rows animate via pure CSS (global.css). Reduced-motion or no
  // IntersectionObserver -> just render the final number (no animation, no CLS).
  const counter = document.querySelector<HTMLElement>('[data-countup]');
  if (counter) {
    const target = Number(counter.getAttribute('data-countup')) || 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduce || !('IntersectionObserver' in window)) {
      counter.textContent = String(target);
    } else {
      counter.textContent = '0';
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            obs.unobserve(entry.target);
            let startTime: number | undefined;
            const duration = 1100;
            const step = (now: number) => {
              if (startTime === undefined) startTime = now;
              const progress = Math.min((now - startTime) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3); // easeOutCubic
              counter.textContent = String(Math.round(eased * target));
              if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        },
        { threshold: 0.6 },
      );
      io.observe(counter);
    }
  }
</script>
