---
/**
 * SiteLayout — page chrome shared by every page: skip-link, Header, <main>,
 * Footer, wrapped in BaseLayout (which owns <html>, SEO and fonts).
 * Pages pass `lang` + `path` (+ optional title/description) and slot content.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getUi, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  path?: string;
  title?: string;
  description?: string;
}
const { lang, path = '/', title, description } = Astro.props;
const t = getUi(lang);
---

<BaseLayout lang={lang} path={path} title={title} description={description}>
  <a
    href="#main"
    class="sr-only rounded-lg focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:bg-brand-600 focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
  >
    {t.a11y.skipToContent}
  </a>

  <Header lang={lang} path={path} />

  <main id="main">
    <slot />
  </main>

  <Footer lang={lang} />
</BaseLayout>
