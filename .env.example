# ---------------------------------------------------------------------------
# Dento marketing site — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Demo-request form submission endpoint (the primary conversion point).
# TODO: Set this to your Formspree form URL, e.g.
#   https://formspree.io/f/abcdwxyz
# or to your own serverless function endpoint.
# Prefixed with PUBLIC_ so it is available to client-side form code in Astro.
# Leave empty to run the form in "demo mode" (no real submission).
PUBLIC_FORM_ENDPOINT=
